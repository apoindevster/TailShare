{
  "name": "tailshare",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build:wasm": "bash scripts/build-wasm.sh",
    "build": "npm run build:wasm && node scripts/notices.mjs && tsc -b && vite build",
    "build:web": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:go": "cd transport && go test ./...",
    "build:test-cli": "bash scripts/build-test-cli.sh",
    "test:e2e": "playwright test",
    "check": "tsc -b",
    "check:dist": "node scripts/check-dist.mjs",
    "format": "prettier --write src tests scripts/*.mjs *.ts *.json index.html"
  },
  "dependencies": {
    "@fontsource/chakra-petch": "5.2.7",
    "@fontsource/ibm-plex-sans": "5.2.7",
    "@noble/hashes": "1.8.0",
    "fflate": "0.8.3",
    "lucide-react": "0.468.0",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/node": "24.19.2",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "4.7.0",
    "prettier": "3.7.4",
    "typescript": "5.9.3",
    "vite": "6.4.6",
    "vitest": "4.1.12"
  },
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10"
  }
}
